# Скопируйте в .env: cp .env.example .env
# Без ключей всё работает, ассистент отвечает шаблонами.

# Любой секрет: им приложение авторизуется у прокси LiteLLM. Пустой - ассистент на шаблонах.
LITELLM_MASTER_KEY=

# Ключ провайдера модели. Его читает только прокси, какой именно - задаёт litellm_config.yaml.
# Сейчас там OpenAI; для другого провайдера заполните его строку, для локальной модели ключ не нужен.
OPENAI_API_KEY=
# GIGACHAT_CREDENTIALS=
# YANDEX_API_KEY=
# ANTHROPIC_API_KEY=

# Имя модели из litellm_config.yaml.
LLM_MODEL=dispatcher

# Порт, на котором приложение доступно снаружи.
APP_PORT=8001

# Геокодер адресов новых заявок (API Nominatim). off - не геокодировать, точка по району.
# GEOCODER_URL=https://nominatim.openstreetmap.org
